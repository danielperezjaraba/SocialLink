# Copia este archivo como .env y completa los valores reales.
# El archivo .env está excluido del repositorio: nunca subas credenciales.

# Cadena de conexión de Supabase.
# La encuentras en Project Settings -> Database, opción "Session pooler",
# en formato URI. Se ve parecida a esto:
# postgresql://postgres.abcdefgh:TU_CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Clave con la que se firman los tokens de sesión.
# Debe ser una cadena larga y aleatoria, mínimo 32 caracteres.
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto en el que escucha la API
PORT=4000

# Origen del frontend autorizado a consumir la API.
# Para varios, sepáralos con comas.
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
